# Server
HOST=0.0.0.0
PORT=9013
COOKIE_SECURE=false
SESSION_DAYS=30
TIMEZONE=Asia/Shanghai
WORKSPACE_NAME=我的课题组

# 国模 / OpenAI-compatible provider. URL、请求路径和模型名都必填；Key 只放服务器。
AI_PROVIDER=国模
AI_BASE_URL=https://api.example.com/v1
AI_CHAT_PATH=/chat/completions
AI_MODEL=your-model-name
AI_API_KEY=replace-on-server

# Set COOKIE_SECURE=true when the site is behind HTTPS.
